# 复制为 .env 后填写；.env 已在 .gitignore 中，不会被提交
# cp .env.example .env

# ---- 欧路词典 ----
# 获取：https://my.eudic.net/OpenAPI/Authorization
# 可以直接填 "NIS xxx"，也可以只填 xxx（程序会自动补 NIS 前缀）
EUDIC_API_KEY=NIS xxxxxxxx

# 生词本 ID，默认生词本为 0；多个用英文逗号分隔，例如 0,133716565810649835
# 运行 `eudic2maimemo doctor` 可列出你所有的生词本 ID
EUDIC_CATEGORY_ID=0

# 语言：en / fr / de / es（欧路词典 / 法语助手 / 德语助手 / 西语助手）
EUDIC_LANGUAGE=en

# ---- 墨墨背单词 ----
# 获取：墨墨 App → 我的 → 更多设置 → 实验功能 → 开放 API
MOMO_API_KEY=xxxxxxxx

# 云词本 ID（np- 开头）。运行 `eudic2maimemo doctor` 可以看到全部可选 ID
MOMO_NOTEPAD_ID=np-xxxxxxxx

# 可选：云词本标题与简介
MOMO_NOTEPAD_TITLE=欧路生词
MOMO_NOTEPAD_BRIEF=来自欧路词典的生词

# 可选：忽略规则（正则，忽略大小写，多个用换行或分号隔开）
# 命中的词条不会写进墨墨。墨墨只认它词典里有的词条，
# 词组、中文、专有名词放进去也生成不了背诵卡片，可以在这里过滤掉。
# 示例：
#   IGNORE_PATTERNS=^\S*\s\S*$;[一-龥]
# 上面这条会跳过「含空格的词组」和「含中文的词条」。
# IGNORE_PATTERNS=

# ---- 可选：常驻模式（serve）----
# 两次同步之间的间隔，单位小时。Docker / systemd 下生效。
# SYNC_INTERVAL_HOURS=24

# ---- 可选：同步结果通知（支持 {content} 占位符）----
# 默认只在有新增词时推送，失败一定推送；设 NOTIFY_ALWAYS=1 则每轮都推。
#
# 企业微信 / 钉钉群机器人：
# NOTIFY_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的KEY
# NOTIFY_BODY={"msgtype":"text","text":{"content":"{content}"}}
#
# Server 酱：
# NOTIFY_URL=https://sctapi.ftqq.com/你的KEY.send?title=单词同步&desp={content}
#
# NOTIFY_ALWAYS=0
